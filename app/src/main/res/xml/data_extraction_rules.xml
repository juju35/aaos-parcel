<?xml version="1.0" encoding="utf-8"?>
<!-- Only the preferences follow to a new car: the API key and check state (parcel_device.xml) and the caches stay on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="parcel.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="parcel.xml" />
    </device-transfer>
</data-extraction-rules>
